# ---------------------------------------------------------------------------
# Lucky Traders - environment configuration
# ---------------------------------------------------------------------------
# Supabase is the only backend. There is no local or file-based fallback: a
# shop that quietly served a different database than the one it was pointed at
# would take orders the owner never sees.
#
# All three Supabase values are in the dashboard under
#   Project Settings -> API
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / public key. Safe to expose to the browser; Row Level Security
# limits it to reading active products, categories and settings, and to
# inserting an order at checkout.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. SERVER ONLY - it bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket used for product and category images.
SUPABASE_STORAGE_BUCKET=product-images

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# This owner account is checked first and always works, so you can sign in to a
# fresh deployment before any Supabase Auth users exist. Additional staff
# accounts are created in Admin -> Admin Users and authenticate through
# Supabase Auth.
ADMIN_EMAIL=admin@luckytraders.lk
ADMIN_PASSWORD=change-this-password

# Signs the admin session cookie. Anyone holding this can forge an admin login.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start in production while this is unset or left as-is.
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string
