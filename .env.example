# ---------------------------------------------------------------------------
# Sillara Kade - environment configuration
# ---------------------------------------------------------------------------
# The app runs with ZERO configuration on a local SQLite database, stored in
# .data/sillara-kade.db. It is free, permanent, needs no server and cannot be
# paused. Back the shop up by copying that one file.
#
# Everything below is optional.
# ---------------------------------------------------------------------------

# Backend override. Leave blank for SQLite (recommended).
#   json = use the plain .data/store.json file instead
DATA_BACKEND=

# Optional: sync the same SQLite database to a hosted libSQL/Turso instance.
# Leave blank to stay entirely local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase - only if you deliberately want Postgres instead of SQLite.
# Leave blank unless you are using it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket used for product / category images
SUPABASE_STORAGE_BUCKET=product-images

# Admin panel login (used when Supabase Auth is not configured)
ADMIN_EMAIL=admin@luckytraders.lk
ADMIN_PASSWORD=change-this-password
# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string
